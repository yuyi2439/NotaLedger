<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon (Android 13+) monochrome layer.

    The system tints this drawable with a single colour taken from the user's
    wallpaper, so it must read as a silhouette: no gradients, no faint greys,
    and no fine detail.

    This is the coloured icon's mark *without* its total rule. The rule is only
    5.5 units below the stem, and the themed icon is drawn as small as 24dp in
    the status bar, where that gap fills in and the mark and the rule merge into
    one blob. Dropping it costs nothing: the "¥" alone still reads, and the
    monochrome layer is allowed to be the simplified form of the artwork rather
    than a copy of it.

    Because there is no rule and no header band to balance, the mark is also
    drawn larger here (x 33.5..74.5, y 27.5..81.8) than on the coloured plate,
    filling the safe zone the way a silhouette should.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arms, meeting the top of the stem at (54,50). -->
    <path
        android:pathData="M37,31L54,50"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M71,31L54,50"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Stem. -->
    <path
        android:pathData="M54,50L54,78"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />

    <!-- Crossbars, 12 units apart so they stay two bars at 24dp. -->
    <path
        android:pathData="M42,57L66,57"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M42,69L66,69"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
