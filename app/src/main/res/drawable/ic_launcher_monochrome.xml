<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon (Android 13+) monochrome layer.

    The system tints this drawable with a single colour taken from the user's
    wallpaper, so it must read as a silhouette: no gradients, no faint greys,
    and no fine detail. So this is the page *outline* plus the yuan mark only —
    the header band and rule lines are dropped, because at 24dp in the status
    bar they would fill in and turn the shape into a solid blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page outline: the foreground sheet offset inward by half the stroke,
         which keeps the drawn edge on exactly the same rectangle (27..81 by
         24..84) as the coloured icon. -->
    <path
        android:pathData="M34,26.5L74,26.5A4.5,4.5 0 0 1 78.5,31L78.5,77A4.5,4.5 0 0 1 74,81.5L34,81.5A4.5,4.5 0 0 1 29.5,77L29.5,31A4.5,4.5 0 0 1 34,26.5Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- Yuan mark: same structure as the coloured icon, re-centred for the
         outline-only page, which has no header band to push it down. -->
    <path
        android:pathData="M46.5,41L54,49.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M61.5,41L54,49.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M54,49.5L54,77"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,58L64,58"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,65L64,65"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />
</vector>
