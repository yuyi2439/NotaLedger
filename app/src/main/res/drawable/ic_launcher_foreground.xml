<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: the yuan mark over a ledger's total rule.

    What changed and why:
      * The old artwork was a white page with a dark header band and two faint
        rule lines. The band was the worst of it — at 96px and below it read as a
        black stripe across the middle of the icon, and the page on a coloured
        plate made the whole thing look like a card inside a card. Both are gone.
      * The mark is all that is left: a "¥" sitting on the short rule a ledger
        draws under a total. One idea, one shape, and a white plate behind it, so
        there is nothing left to look wrong at small sizes.
      * Colour comes from the app's own Compose palette (ui/theme/Theme.kt): the
        primary teal 0xFF00695C. It is the brand colour used as a *mark* on white
        now rather than as a full-bleed field, which is what gives it contrast:
        7:1 against the plate instead of teal-on-teal.

    Layout rules this file follows on purpose:
      * Everything lives inside x 31..77, y 25..83. Adaptive icons only guarantee
        a 72x72 safe zone in the middle of the 108x108 canvas, so nothing that
        matters may drift closer to the edge.
      * The mark is a currency sign, not text: "¥" stays crisp at 24dp, where a
        whole word would smear into noise.
      * Strokes are 6-7.5 canvas units (~2.7-3.3px at 48dp) with round caps, and
        the two crossbars are 11 units apart so the 4.5-unit gap between them
        survives the launcher's downscale to 24px instead of filling in.
      * Widths step up from the crossbars (20) to the arms (30) to the rule (40),
        which is what keeps the mark legible when it is only a few pixels tall.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The two arms of the mark, meeting the top of the stem at (54,45.5). -->
    <path
        android:pathData="M39,28.5L54,45.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M69,28.5L54,45.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Vertical stem. A touch heavier than the arms, as in a real "¥". -->
    <path
        android:pathData="M54,45.5L54,67.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />

    <!-- The two crossbars that turn the "Y" into a "¥". -->
    <path
        android:pathData="M44,52.5L64,52.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,63.5L64,63.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- The total rule: the line a ledger draws under a sum. Wider and lighter
         than the crossbars so it reads as a base for the mark and not as a third
         bar, and far enough below the stem that the two never touch. -->
    <path
        android:pathData="M34,79.5L74,79.5"
        android:strokeColor="#FF00695C"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
