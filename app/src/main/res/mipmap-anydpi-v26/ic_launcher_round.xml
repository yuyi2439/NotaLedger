<?xml version="1.0" encoding="utf-8"?>
<!-- Round-mask variant. Identical content to ic_launcher.xml on purpose: the
     platform's adaptive-icon masking already handles shape, and giving the
     round entry its own artwork would only make the two icons drift apart. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
